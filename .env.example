# Datenbank (lokal über docker-compose.dev.yml, Port 5433)
DATABASE_URL="postgresql://proxledger:proxledger@localhost:5433/proxledger?schema=public"

# Eigene Datenbank für automatisierte Tests
TEST_DATABASE_URL="postgresql://proxledger:proxledger@localhost:5433/proxledger_test?schema=public"

# Lokaler Administrator, wird vom Seed angelegt
ADMIN_EMAIL="admin@example.de"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD="bitte-aendern"

# Öffentlich erreichbare Adresse des Dashboards (für install.sh und E-Mails)
APP_URL="http://localhost:3000"

# Ablage für hochgeladene Rechnungs-PDFs
UPLOAD_DIR="./data/uploads"

# Demo-Daten beim Seed anlegen (1 = ja)
SEED_DEMO="0"

# Abgleich der Issue-Dateien mit dem Gitea-Tracker (npm run issues:sync)
GITEA_URL="https://git.example.de"
GITEA_REPO="benutzer/ProxLedger"
GITEA_TOKEN=""
