# Für docker-compose.yml: Zugangsdaten der mitgelieferten Datenbank
POSTGRES_USER="proxledger"
POSTGRES_PASSWORD="bitte-aendern"
POSTGRES_DB="proxledger"
PORT="3000"

# Datenbank (lokale Entwicklung über docker-compose.dev.yml, Port 5433)
DATABASE_URL="postgresql://proxledger:proxledger@localhost:5433/proxledger?schema=public"

# Eigene Datenbank für automatisierte Tests
TEST_DATABASE_URL="postgresql://proxledger:proxledger@localhost:5433/proxledger_test?schema=public"

# Lokaler Administrator, wird vom Seed angelegt
ADMIN_EMAIL="admin@example.de"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD="bitte-aendern"

# Schlüssel für Sitzungs-Cookies (mindestens 32 Zeichen): openssl rand -base64 48
APP_SECRET="bitte-eigenen-wert-erzeugen-mindestens-32-zeichen"

# Anmeldung über OIDC (optional, z. B. authentik). Ohne diese Werte gibt es nur den lokalen Zugang.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_NAME="authentik"

# Öffentlich erreichbare Adresse des Dashboards (für install.sh und E-Mails)
APP_URL="http://localhost:3000"

# Zeitplan des Workers (Standard: stündlich zur vollen Stunde)
WORKER_CRON="0 * * * *"

# Zeitplan der Zusammenfassung (Standard: täglich 07:00 Uhr)
ZUSAMMENFASSUNG_CRON="0 7 * * *"

# Ablage für hochgeladene Rechnungs-PDFs
UPLOAD_DIR="./data/uploads"

# Demo-Daten beim Seed anlegen (1 = ja)
SEED_DEMO="0"

# Abgleich der Issue-Dateien mit dem Gitea-Tracker (npm run issues:sync)
GITEA_URL="https://git.example.de"
GITEA_REPO="benutzer/ProxLedger"
GITEA_TOKEN=""
