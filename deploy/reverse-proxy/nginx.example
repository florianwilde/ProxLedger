# nginx mit Zertifikat von certbot.
# Datei: /etc/nginx/sites-available/proxledger

server {
    listen 80;
    server_name proxledger.example.de;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name proxledger.example.de;

    ssl_certificate     /etc/letsencrypt/live/proxledger.example.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/proxledger.example.de/privkey.pem;

    # Rechnungs-PDFs können größer sein als die Standardgrenze.
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Die Agent-API wertet diese Kopfzeile für das Rate-Limit aus.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
